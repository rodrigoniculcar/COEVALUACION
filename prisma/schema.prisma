// Modelo de datos - Sistema de Autoevaluación y Coevaluación grupal
// Ver ARCHITECTURE.md para el diseño y las decisiones detrás de cada entidad.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Conexión con pool (Supabase Transaction Pooler, puerto 6543) para la app
  // serverless en Vercel. Ver .env.example y README.md.
  url       = env("DATABASE_URL")
  // Conexión directa (Supabase, puerto 5432) usada solo por las migraciones.
  directUrl = env("DIRECT_URL")
}

enum Rol {
  ADMINISTRADOR
  DOCENTE
  ESTUDIANTE
}

enum EstadoPeriodo {
  BORRADOR // el docente aún está configurando pesos/rúbrica
  ABIERTO // estudiantes pueden autoevaluarse y coevaluar
  CERRADO // se calculan y publican los resultados finales
}

enum TipoEvaluacion {
  AUTOEVALUACION
  COEVALUACION
  DOCENTE
}

model User {
  id           String   @id @default(cuid())
  nombre       String
  email        String   @unique
  passwordHash String
  rol          Rol
  // El administrador puede desactivar una cuenta (docente o estudiante) sin
  // borrarla; una cuenta inactiva no puede iniciar sesión (ver src/lib/auth.ts).
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())

  cursosComoDocente Curso[]           @relation("DocenteCursos")
  inscripciones     Inscripcion[]
  membresias        MiembroGrupo[]
  evaluacionesHechas   Evaluacion[]   @relation("Evaluador")
  evaluacionesRecibidas Evaluacion[]  @relation("Evaluado")
  resultados        Resultado[]
}

// Un curso pertenece a un docente y agrupa estudiantes, grupos, rúbricas y periodos.
model Curso {
  id        String   @id @default(cuid())
  nombre    String
  codigo    String   @unique
  docenteId String
  docente   User     @relation("DocenteCursos", fields: [docenteId], references: [id])
  createdAt DateTime @default(now())

  inscripciones Inscripcion[]
  rubricas      Rubrica[]
  periodos      PeriodoEvaluacion[]

  @@index([docenteId])
}

// Carga de alumnos a un curso (matrícula).
model Inscripcion {
  id           String   @id @default(cuid())
  cursoId      String
  estudianteId String
  createdAt    DateTime @default(now())

  curso      Curso @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  estudiante User  @relation(fields: [estudianteId], references: [id])

  @@unique([cursoId, estudianteId])
  @@index([estudianteId])
}

// Equipo de trabajo para UN periodo de evaluación específico (no del curso en
// general): la conformación de equipos puede cambiar de una evaluación a
// otra, así que cada PeriodoEvaluacion tiene su propio conjunto de Grupo.
model Grupo {
  id        String   @id @default(cuid())
  periodoId String
  nombre    String
  createdAt DateTime @default(now())

  periodo   PeriodoEvaluacion @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  miembros  MiembroGrupo[]
  evaluaciones Evaluacion[]
  resultados   Resultado[]

  @@unique([periodoId, nombre])
}

model MiembroGrupo {
  id           String @id @default(cuid())
  grupoId      String
  estudianteId String

  grupo      Grupo @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  estudiante User  @relation(fields: [estudianteId], references: [id])

  @@unique([grupoId, estudianteId])
}

// Rúbrica reutilizable dentro de un curso, con criterios ponderados.
model Rubrica {
  id          String   @id @default(cuid())
  cursoId     String
  nombre      String
  descripcion String?
  escalaMin   Int      @default(1)
  escalaMax   Int      @default(5)
  createdAt   DateTime @default(now())

  curso    Curso              @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  criterios CriterioRubrica[]
  periodos  PeriodoEvaluacion[]
}

// Criterio individual de la rúbrica. `ponderacion` es el peso (%) de este
// criterio dentro de la nota de UNA evaluación (auto/co/docente); la suma
// de ponderaciones de los criterios de una rúbrica debe ser 100 (calculada
// sobre los criterios aplicables a cada tipo de evaluación por separado).
// Los flags `aplicaX` permiten que un criterio solo lo vea/responda cierto
// tipo de evaluador (ej. un criterio que solo evalúa el docente).
model CriterioRubrica {
  id          String  @id @default(cuid())
  rubricaId   String
  nombre      String
  descripcion String?
  ponderacion Float
  orden       Int     @default(0)

  aplicaAutoevaluacion Boolean @default(true)
  aplicaCoevaluacion   Boolean @default(true)
  aplicaDocente        Boolean @default(true)

  rubrica  Rubrica            @relation(fields: [rubricaId], references: [id], onDelete: Cascade)
  detalles DetalleEvaluacion[]

  @@index([rubricaId])
}

// Periodo de evaluación: define la ventana de tiempo, la rúbrica a usar y
// los pesos relativos de autoevaluación / coevaluación / evaluación docente
// que se combinan para la nota final (deben sumar 100).
model PeriodoEvaluacion {
  id          String        @id @default(cuid())
  cursoId     String
  rubricaId   String
  nombre      String
  fechaInicio DateTime
  fechaFin    DateTime
  pesoAutoevaluacion Float  @default(20)
  pesoCoevaluacion   Float  @default(40)
  pesoDocente        Float  @default(40)
  // Porcentaje de exigencia para convertir la nota 0-100 a escala chilena
  // 1.0-7.0 (60 o 70 son los valores típicos; ver src/lib/grading.ts).
  escalaExigencia    Int           @default(60)
  estado      EstadoPeriodo @default(BORRADOR)
  createdAt   DateTime      @default(now())

  curso       Curso        @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  rubrica     Rubrica      @relation(fields: [rubricaId], references: [id])
  grupos       Grupo[]
  evaluaciones Evaluacion[]
  resultados   Resultado[]

  @@index([cursoId])
}

// Una Evaluacion es un "formulario" de rúbrica completado por un evaluador
// sobre un evaluado (puede ser el mismo, un compañero, o un estudiante
// evaluado por el docente), dentro de un periodo y en el contexto de un grupo.
model Evaluacion {
  id          String         @id @default(cuid())
  periodoId   String
  tipo        TipoEvaluacion
  evaluadorId String
  evaluadoId  String
  grupoId     String
  comentario  String?
  createdAt   DateTime       @default(now())

  periodo   PeriodoEvaluacion   @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  evaluador User                @relation("Evaluador", fields: [evaluadorId], references: [id])
  evaluado  User                @relation("Evaluado", fields: [evaluadoId], references: [id])
  grupo     Grupo               @relation(fields: [grupoId], references: [id])
  detalles  DetalleEvaluacion[]

  // Un evaluador solo puede enviar una evaluación de cada tipo sobre un
  // mismo evaluado dentro de un periodo (evita doble envío).
  @@unique([periodoId, tipo, evaluadorId, evaluadoId])
  @@index([periodoId, evaluadoId])
}

// Puntaje asignado a cada criterio dentro de una Evaluacion.
model DetalleEvaluacion {
  id          String @id @default(cuid())
  evaluacionId String
  criterioId   String
  puntaje      Float

  evaluacion Evaluacion      @relation(fields: [evaluacionId], references: [id], onDelete: Cascade)
  criterio   CriterioRubrica @relation(fields: [criterioId], references: [id])

  @@unique([evaluacionId, criterioId])
}

// Resultado final calculado (y cacheado) para un estudiante en un periodo.
// Se recalcula cada vez que cambian las evaluaciones o al cerrar el periodo.
model Resultado {
  id          String   @id @default(cuid())
  periodoId   String
  estudianteId String
  grupoId     String

  notaAutoevaluacion Float?
  notaCoevaluacion   Float?
  notaDocente        Float?
  notaFinal          Float
  // notaFinal (0-100) convertida a escala chilena 1.0-7.0 según la
  // exigencia configurada en el periodo (PeriodoEvaluacion.escalaExigencia).
  notaEscala1a7      Float @default(1)

  // Foto histórica del equipo al momento del cálculo: si más adelante el
  // docente renombra el grupo o cambia sus integrantes para un nuevo
  // periodo, este reporte sigue mostrando el equipo tal como era entonces.
  grupoNombre           String @default("")
  integrantesHistoricos Json   @default("[]")

  // Promedio por criterio (para detectar indicadores críticos) y texto de
  // retroalimentación generado automáticamente. Se guardan como JSON para
  // no tener que crear una tabla adicional por cada criterio.
  detalleCriterios Json
  retroalimentacion String
  calculadoAt       DateTime @default(now())

  periodo    PeriodoEvaluacion @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  estudiante User              @relation(fields: [estudianteId], references: [id])
  grupo      Grupo             @relation(fields: [grupoId], references: [id])

  @@unique([periodoId, estudianteId])
  @@index([periodoId, grupoId])
}
