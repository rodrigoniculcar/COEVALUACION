// Modelo de datos - Sistema de Autoevaluación y Coevaluación grupal
// Ver ARCHITECTURE.md para el diseño y las decisiones detrás de cada entidad.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Conexión con pool (Supabase Transaction Pooler, puerto 6543) para la app
  // serverless en Vercel. Ver .env.example y README.md.
  url       = env("DATABASE_URL")
  // Conexión directa (Supabase, puerto 5432) usada solo por las migraciones.
  directUrl = env("DIRECT_URL")
}

enum Rol {
  ADMINISTRADOR
  DOCENTE
  ESTUDIANTE
}

enum EstadoPeriodo {
  BORRADOR // el docente aún está configurando pesos/rúbrica
  ABIERTO // estudiantes pueden autoevaluarse y coevaluar
  CERRADO // se calculan y publican los resultados finales
}

enum TipoEvaluacion {
  AUTOEVALUACION
  COEVALUACION
  DOCENTE
}

model User {
  id           String   @id @default(cuid())
  // RUT chileno (opcional): útil como identificador adicional al cargar
  // estudiantes/docentes en bloque, pero no todas las cuentas lo tienen
  // (ej. las creadas por bootstrap-admin), por eso es nullable.
  rut          String?  @unique
  nombre       String
  email        String   @unique
  passwordHash String
  rol          Rol
  // El administrador puede desactivar una cuenta (docente o estudiante) sin
  // borrarla; una cuenta inactiva no puede iniciar sesión (ver src/lib/auth.ts).
  activo       Boolean  @default(true)
  // Foto de perfil como data URL (base64), redimensionada y comprimida en
  // el navegador antes de subirla. La app no usa almacenamiento de
  // archivos externo, así que se guarda directo en la base de datos; nunca
  // se incluye en la sesión/JWT (solo se lee vía GET /api/perfil) para no
  // inflar la cookie de sesión.
  fotoUrl      String?
  // Fecha del último inicio de sesión exitoso (nunca de intentos fallidos),
  // actualizada en lib/auth.ts. Usado por el panel de administración para
  // mostrar la última actividad de cada docente.
  ultimoLogin  DateTime?
  createdAt    DateTime @default(now())

  asignaturas   Asignatura[]  @relation("DocenteAsignaturas")
  inscripciones Inscripcion[]
  membresias    MiembroGrupo[]
  evaluacionesHechas    Evaluacion[] @relation("Evaluador")
  evaluacionesRecibidas Evaluacion[] @relation("Evaluado")
  resultados    Resultado[]
  // Rúbricas que este docente creó originalmente. La rúbrica es una
  // biblioteca pública: cualquier docente puede verla, asignarla a sus
  // propias evaluaciones y editarla; `creador` es solo atribución.
  rubricasCreadas Rubrica[] @relation("RubricaCreador")
  // Periodos de evaluación de OTROS docentes donde este docente fue agregado
  // como coevaluador (ver DocenteEvaluador).
  coevaluaciones  DocenteEvaluador[]
}

// Una asignatura pertenece a un docente (quien la dicta/coordina) y agrupa
// sus secciones. Es reutilizable a través de distintos años-semestre: cada
// oferta concreta en un periodo académico es una Seccion.
model Asignatura {
  id        String   @id @default(cuid())
  nombre    String
  codigo    String   @unique
  docenteId String
  docente   User     @relation("DocenteAsignaturas", fields: [docenteId], references: [id])
  createdAt DateTime @default(now())

  secciones Seccion[]

  @@index([docenteId])
}

// Catálogo de años-semestre (ej. "2026-1", "2026-2"), compartido por toda la
// plataforma para evitar duplicados/inconsistencias de nombre entre
// docentes. Cualquier docente puede crear uno nuevo si no existe.
model PeriodoAcademico {
  id        String   @id @default(cuid())
  nombre    String   @unique
  // Marca cuál es el semestre "vigente": el panel de resultados del
  // estudiante lo usa para mostrar por defecto solo ese periodo (y dejar
  // los anteriores detrás de un filtro). Solo debe haber uno en true a la
  // vez (lo gestiona PATCH /api/periodos-academicos/[id]).
  actual    Boolean  @default(false)
  createdAt DateTime @default(now())

  secciones Seccion[]
}

// Instancia concreta de una Asignatura dictada en un PeriodoAcademico
// específico, con su propio roster fijo de estudiantes (Inscripcion). Un
// mismo docente puede tener varias secciones a cargo de una misma
// asignatura (ej. "Sección A" y "Sección B" del mismo semestre).
model Seccion {
  id                 String   @id @default(cuid())
  asignaturaId       String
  periodoAcademicoId String
  nombre             String
  createdAt          DateTime @default(now())

  asignatura       Asignatura       @relation(fields: [asignaturaId], references: [id], onDelete: Cascade)
  periodoAcademico PeriodoAcademico @relation(fields: [periodoAcademicoId], references: [id])
  inscripciones    Inscripcion[]
  evaluaciones     PeriodoEvaluacion[]

  @@unique([asignaturaId, periodoAcademicoId, nombre])
  @@index([asignaturaId])
  @@index([periodoAcademicoId])
}

// Carga de alumnos a una sección (matrícula). El roster de una sección es
// fijo: los mismos estudiantes se mantienen a través de todas sus
// evaluaciones (a diferencia de los Grupo, que sí cambian por evaluación).
model Inscripcion {
  id           String   @id @default(cuid())
  seccionId    String
  estudianteId String
  createdAt    DateTime @default(now())

  seccion    Seccion @relation(fields: [seccionId], references: [id], onDelete: Cascade)
  estudiante User    @relation(fields: [estudianteId], references: [id])

  @@unique([seccionId, estudianteId])
  @@index([estudianteId])
}

// Equipo de trabajo para UN periodo de evaluación específico (no de la
// sección en general): la conformación de equipos puede cambiar de una
// evaluación a otra, así que cada PeriodoEvaluacion tiene su propio
// conjunto de Grupo.
model Grupo {
  id        String   @id @default(cuid())
  periodoId String
  nombre    String
  createdAt DateTime @default(now())

  periodo   PeriodoEvaluacion @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  miembros  MiembroGrupo[]
  evaluaciones Evaluacion[]
  resultados   Resultado[]

  @@unique([periodoId, nombre])
}

model MiembroGrupo {
  id           String @id @default(cuid())
  grupoId      String
  estudianteId String

  grupo      Grupo @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  estudiante User  @relation(fields: [estudianteId], references: [id])

  @@unique([grupoId, estudianteId])
}

// Rúbrica reutilizable: es una biblioteca PÚBLICA entre docentes (cualquier
// docente puede verla, asignarla a sus propias evaluaciones y editarla,
// sin importar quién la creó). `creadorId` es solo atribución/historial.
model Rubrica {
  id          String   @id @default(cuid())
  creadorId   String
  nombre      String
  descripcion String?
  escalaMin   Int      @default(1)
  escalaMax   Int      @default(5)
  createdAt   DateTime @default(now())

  creador   User                @relation("RubricaCreador", fields: [creadorId], references: [id])
  criterios CriterioRubrica[]
  periodos  PeriodoEvaluacion[]
}

// Criterio individual de la rúbrica. `ponderacion` es el peso (%) de este
// criterio dentro de la nota de UNA evaluación (auto/co/docente); la suma
// de ponderaciones de los criterios de una rúbrica debe ser 100 (calculada
// sobre los criterios aplicables a cada tipo de evaluación por separado).
// Los flags `aplicaX` permiten que un criterio solo lo vea/responda cierto
// tipo de evaluador (ej. un criterio que solo evalúa el docente).
model CriterioRubrica {
  id          String  @id @default(cuid())
  rubricaId   String
  nombre      String
  descripcion String?
  ponderacion Float
  orden       Int     @default(0)

  aplicaAutoevaluacion Boolean @default(true)
  aplicaCoevaluacion   Boolean @default(true)
  aplicaDocente        Boolean @default(true)

  rubrica  Rubrica            @relation(fields: [rubricaId], references: [id], onDelete: Cascade)
  detalles DetalleEvaluacion[]

  @@index([rubricaId])
}

// Periodo (evaluación) dentro de una Sección: define la ventana de tiempo,
// la rúbrica a usar y los pesos relativos de autoevaluación / coevaluación
// / evaluación docente que se combinan para la nota final (deben sumar
// 100).
model PeriodoEvaluacion {
  id          String        @id @default(cuid())
  seccionId   String
  rubricaId   String
  nombre      String
  fechaInicio DateTime
  fechaFin    DateTime
  pesoAutoevaluacion Float  @default(20)
  pesoCoevaluacion   Float  @default(40)
  pesoDocente        Float  @default(40)
  // Porcentaje de exigencia para convertir la nota 0-100 a escala chilena
  // 1.0-7.0 (60 o 70 son los valores típicos; ver src/lib/grading.ts).
  escalaExigencia    Int           @default(60)
  estado      EstadoPeriodo @default(BORRADOR)
  createdAt   DateTime      @default(now())

  seccion     Seccion      @relation(fields: [seccionId], references: [id], onDelete: Cascade)
  rubrica     Rubrica      @relation(fields: [rubricaId], references: [id])
  grupos       Grupo[]
  evaluaciones Evaluacion[]
  resultados   Resultado[]
  // Docentes adicionales (además del titular, dueño de la Asignatura)
  // autorizados a registrar evaluaciones de tipo DOCENTE en este periodo.
  // Sus notas se promedian junto con la del titular en un solo notaDocente.
  docentesEvaluadores DocenteEvaluador[]

  @@index([seccionId])
}

// Docente adicional agregado como coevaluador de un periodo de evaluación
// específico: puede registrar evaluaciones de tipo DOCENTE para los
// estudiantes de ese periodo, junto con el docente titular (dueño de la
// Asignatura/Sección). No tiene permiso para editar la configuración del
// periodo ni gestionar equipos, solo para calificar.
model DocenteEvaluador {
  id        String   @id @default(cuid())
  periodoId String
  docenteId String
  createdAt DateTime @default(now())

  periodo PeriodoEvaluacion @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  docente User              @relation(fields: [docenteId], references: [id])

  @@unique([periodoId, docenteId])
}

// Una Evaluacion es un "formulario" de rúbrica completado por un evaluador
// sobre un evaluado (puede ser el mismo, un compañero, o un estudiante
// evaluado por un docente —titular o coevaluador—), dentro de un periodo y
// en el contexto de un grupo.
model Evaluacion {
  id          String         @id @default(cuid())
  periodoId   String
  tipo        TipoEvaluacion
  evaluadorId String
  evaluadoId  String
  grupoId     String
  comentario  String?
  createdAt   DateTime       @default(now())

  periodo   PeriodoEvaluacion   @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  evaluador User                @relation("Evaluador", fields: [evaluadorId], references: [id])
  evaluado  User                @relation("Evaluado", fields: [evaluadoId], references: [id])
  grupo     Grupo               @relation(fields: [grupoId], references: [id])
  detalles  DetalleEvaluacion[]

  // Un evaluador solo puede enviar una evaluación de cada tipo sobre un
  // mismo evaluado dentro de un periodo (evita doble envío). Esto también
  // permite que varios docentes (titular + coevaluadores) registren cada
  // uno su propia evaluación DOCENTE sobre el mismo estudiante.
  @@unique([periodoId, tipo, evaluadorId, evaluadoId])
  @@index([periodoId, evaluadoId])
}

// Puntaje asignado a cada criterio dentro de una Evaluacion.
model DetalleEvaluacion {
  id          String @id @default(cuid())
  evaluacionId String
  criterioId   String
  puntaje      Float

  evaluacion Evaluacion      @relation(fields: [evaluacionId], references: [id], onDelete: Cascade)
  criterio   CriterioRubrica @relation(fields: [criterioId], references: [id])

  @@unique([evaluacionId, criterioId])
}

// Resultado final calculado (y cacheado) para un estudiante en un periodo.
// Se recalcula cada vez que cambian las evaluaciones o al cerrar el periodo.
model Resultado {
  id          String   @id @default(cuid())
  periodoId   String
  estudianteId String
  grupoId     String

  notaAutoevaluacion Float?
  notaCoevaluacion   Float?
  notaDocente        Float?
  notaFinal          Float
  // notaFinal (0-100) convertida a escala chilena 1.0-7.0 según la
  // exigencia configurada en el periodo (PeriodoEvaluacion.escalaExigencia).
  notaEscala1a7      Float @default(1)

  // Foto histórica del equipo al momento del cálculo: si más adelante el
  // docente renombra el grupo o cambia sus integrantes para un nuevo
  // periodo, este reporte sigue mostrando el equipo tal como era entonces.
  grupoNombre           String @default("")
  integrantesHistoricos Json   @default("[]")

  // Promedio por criterio (para detectar indicadores críticos) y texto de
  // retroalimentación generado automáticamente. Se guardan como JSON para
  // no tener que crear una tabla adicional por cada criterio.
  detalleCriterios Json
  retroalimentacion String
  calculadoAt       DateTime @default(now())

  periodo    PeriodoEvaluacion @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  estudiante User              @relation(fields: [estudianteId], references: [id])
  grupo      Grupo             @relation(fields: [grupoId], references: [id])

  @@unique([periodoId, estudianteId])
  @@index([periodoId, grupoId])
}
