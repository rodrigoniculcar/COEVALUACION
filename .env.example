# === Base de datos (Supabase / PostgreSQL) ===
# Supabase entrega DOS cadenas de conexión (Project Settings → Database → Connection string):
#
# 1) DATABASE_URL -> "Transaction pooler" (puerto 6543). La usa la app en Vercel
#    (serverless). Debe llevar ?pgbouncer=true al final.
# 2) DIRECT_URL   -> "Direct connection"  (puerto 5432). La usan solo las migraciones
#    de Prisma (prisma migrate deploy / dev).
#
# Reemplaza [PASSWORD], [PROJECT-REF] y [REGION] por los de tu proyecto Supabase.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Para desarrollo local con Postgres local (docker compose up -d), puedes usar:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/coevaluacion?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/coevaluacion?schema=public"

# === Autenticación (NextAuth) ===
# Genera un valor con: openssl rand -base64 32
NEXTAUTH_SECRET="reemplaza-esto-por-un-valor-aleatorio-seguro"

# URL pública de la app (en Vercel: https://tu-proyecto.vercel.app)
NEXTAUTH_URL="http://localhost:3000"
