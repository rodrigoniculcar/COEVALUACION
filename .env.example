# Cadena de conexión a PostgreSQL (Neon, Vercel Postgres, Supabase o local).
DATABASE_URL="postgresql://usuario:password@localhost:5432/coevaluacion?schema=public"

# Genera un valor con: openssl rand -base64 32
NEXTAUTH_SECRET="reemplaza-esto-por-un-valor-aleatorio-seguro"

# URL pública de la app (en Vercel: https://tu-proyecto.vercel.app)
NEXTAUTH_URL="http://localhost:3000"
